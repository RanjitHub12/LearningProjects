# Application
ENVIRONMENT=production
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=https://your-frontend-domain.example

# Database and cache are supplied by Docker Compose or your hosting provider.
POSTGRES_USER=codevault
POSTGRES_PASSWORD=replace-with-a-long-database-password
POSTGRES_DB=codevault_db

# AI provider keys
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional object storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=codevault-files
